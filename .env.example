# Variáveis de Ambiente - PDV
# Copie este arquivo para .env e preencha os valores reais

# Database
DATABASE_URL=sqlite:///pdv.db

# Logging
LOG_LEVEL=INFO

# API (se usar integração com APIs)
API_DEBUG=False
API_TIMEOUT=30

# Sistema
APP_NAME=PDV
APP_VERSION=1.0.0
ENVIRONMENT=development

# Segurança
SECRET_KEY=sua-chave-secreta-aqui-mudar-em-producao
DEBUG=True

# Email (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-ou-token

# Relatórios
REPORT_OUTPUT_DIR=./reports
BACKUP_DIR=./backups
